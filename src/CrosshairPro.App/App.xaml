<Application x:Class="CrosshairPro.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CrosshairPro.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Design system: tokens + control styles -->
                <ResourceDictionary Source="Themes/ControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared converters -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

            <!-- String to Visibility Converter (shows when not null/empty) -->
            <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

            <!-- Config Type to Visibility Converter -->
            <local:ConfigTypeToVisibilityConverter x:Key="ConfigTypeToVisibilityConverter"/>

            <!-- Int to Bool Converter (0 = false, non-0 = true) -->
            <local:IntToBoolConverter x:Key="IntToBoolConverter"/>

            <!-- Inverse Boolean to Visibility Converter (true = Collapsed) -->
            <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>

            <!-- Global implicit styles (reference design tokens) -->
            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"/>

            <Style TargetType="TextBox" BasedOn="{StaticResource CustomTextBox}"/>

            <Style TargetType="ComboBox" BasedOn="{StaticResource CustomComboBox}"/>

            <Style TargetType="CheckBox" BasedOn="{StaticResource CustomCheckBox}"/>

            <Style TargetType="Expander" BasedOn="{StaticResource CustomExpander}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
