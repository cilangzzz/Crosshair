<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:presentationoptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- ═══════════════════════════════════════════════════════════
         DESIGN TOKENS — CrosshairPro
         Gaming-precision dark UI: deep space purple + neon accent
         画笔全部冻结（PresentationOptions:Freeze）：主题令牌运行时不可变；
         冻结后模板内属性路径动画（如 ToggleSwitch/按钮悬停的 ColorAnimation）
         会在元素实例上自动克隆画笔，避免原地改写全局共享资源污染全应用颜色
         ═══════════════════════════════════════════════════════════ -->

    <!-- ── COLOR SYSTEM ── -->

    <!-- Backgrounds (3-level depth) -->
    <Color x:Key="BackgroundColor">#0D0D1A</Color>
    <Color x:Key="SurfaceColor">#161628</Color>
    <Color x:Key="ControlColor">#1E1E36</Color>
    <Color x:Key="ControlHoverColor">#262645</Color>
    <Color x:Key="ControlPressedColor">#1A1A30</Color>

    <!-- Borders -->
    <Color x:Key="BorderColor">#2A2A4A</Color>
    <Color x:Key="BorderFocusColor">#3D3D60</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#F0F0F5</Color>
    <Color x:Key="TextSecondaryColor">#9898B0</Color>
    <Color x:Key="TextDisabledColor">#5A5A78</Color>

    <!-- Accent: Neon Green (signal = active / on / enabled) -->
    <Color x:Key="AccentColor">#00FF00</Color>
    <Color x:Key="AccentHoverColor">#00CC00</Color>
    <Color x:Key="AccentDimColor">#009900</Color>
    <Color x:Key="AccentGlowColor">#33FF33</Color>
    <Color x:Key="AccentTintColor">#0D260D</Color>

    <!-- Secondary Accent: Purple (info / decorative / non-active states) -->
    <Color x:Key="SecondaryAccentColor">#7B61FF</Color>
    <Color x:Key="SecondaryAccentHoverColor">#9580FF</Color>
    <Color x:Key="SecondaryAccentTintColor">#1A1433</Color>

    <!-- Semantic Colors -->
    <Color x:Key="SuccessColor">#00FF00</Color>
    <Color x:Key="WarningColor">#FFB800</Color>
    <Color x:Key="ErrorColor">#FF3366</Color>

    <!-- ── SOLID BRUSHES（全部冻结） ── -->

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" presentationoptions:Freeze="True"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" presentationoptions:Freeze="True"/>
    <SolidColorBrush x:Key="ControlBrush" Color="{StaticResource ControlColor}" presentationoptions:Freeze="True"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource ControlHoverColor}" presentationoptions:Freeze="True"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="{StaticResource ControlPressedColor}" presentationoptions:Freeze="True"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" presentationoptions:Freeze="True"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}" presentationoptions:Freeze="True"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" presentationoptions:Freeze="True"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" presentationoptions:Freeze="True"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" presentationoptions:Freeze="True"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" presentationoptions:Freeze="True"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" presentationoptions:Freeze="True"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}" presentationoptions:Freeze="True"/>
    <SolidColorBrush x:Key="AccentTintBrush" Color="{StaticResource AccentTintColor}" presentationoptions:Freeze="True"/>

    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource SecondaryAccentColor}" presentationoptions:Freeze="True"/>
    <SolidColorBrush x:Key="SecondaryAccentHoverBrush" Color="{StaticResource SecondaryAccentHoverColor}" presentationoptions:Freeze="True"/>
    <SolidColorBrush x:Key="SecondaryAccentTintBrush" Color="{StaticResource SecondaryAccentTintColor}" presentationoptions:Freeze="True"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" presentationoptions:Freeze="True"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" presentationoptions:Freeze="True"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" presentationoptions:Freeze="True"/>

    <!-- ── TYPOGRAPHY ── -->
    <!-- Font: Microsoft YaHei UI / Segoe UI (system default, loaded in App.xaml) -->

    <FontFamily x:Key="FontFamilyPrimary">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamilyMono">Cascadia Code, Consolas, Courier New</FontFamily>

    <!-- Size tokens (reference only, applied directly in styles) -->
    <sys:Double x:Key="FontSizeDisplay" xmlns:sys="clr-namespace:System;assembly=mscorlib">24</sys:Double>
    <sys:Double x:Key="FontSizeHeading" xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>
    <sys:Double x:Key="FontSizeBody" xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>
    <sys:Double x:Key="FontSizeCaption" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>
    <sys:Double x:Key="FontSizeLabel" xmlns:sys="clr-namespace:System;assembly=mscorlib">11</sys:Double>

    <!-- ── SPACING (8px base grid) ── -->

    <sys:Double x:Key="SpaceXs" xmlns:sys="clr-namespace:System;assembly=mscorlib">4</sys:Double>
    <sys:Double x:Key="SpaceSm" xmlns:sys="clr-namespace:System;assembly=mscorlib">8</sys:Double>
    <sys:Double x:Key="SpaceMd" xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>
    <sys:Double x:Key="SpaceLg" xmlns:sys="clr-namespace:System;assembly=mscorlib">24</sys:Double>
    <sys:Double x:Key="SpaceXl" xmlns:sys="clr-namespace:System;assembly=mscorlib">32</sys:Double>

    <!-- ── RADII ── -->

    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">6</CornerRadius>
    <CornerRadius x:Key="RadiusLg">8</CornerRadius>

    <!-- ── EFFECTS ── -->

    <!-- Accent glow (used on focused/active elements) -->
    <DropShadowEffect x:Key="AccentGlowEffect"
                      Color="{StaticResource AccentGlowColor}"
                      BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>

    <!-- Subtle card depth -->
    <DropShadowEffect x:Key="CardShadowEffect"
                      Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.3"
                      Direction="270"/>

    <!-- ═══════════════════════════════════════════════════════════
         ADDITIONAL THEME COLORS - For code-behind access
         ═══════════════════════════════════════════════════════════ -->

    <!-- Shadow Colors (用于对话框、卡片阴影) -->
    <Color x:Key="ShadowColor">#000000</Color>

    <!-- Grid Colors (用于预览网格线) -->
    <Color x:Key="GridLineColor">#3C3C50</Color>
    <Color x:Key="GridCenterLineColor">#505064</Color>

    <!-- Dialog Colors -->
    <Color x:Key="DialogShadowColor">#000000</Color>

    <!-- Toast Colors -->
    <Color x:Key="ToastShadowColor">#000000</Color>

    <!-- Grid Brushes（冻结） -->
    <SolidColorBrush x:Key="GridLineBrush" Color="{StaticResource GridLineColor}" presentationoptions:Freeze="True"/>
    <SolidColorBrush x:Key="GridCenterLineBrush" Color="{StaticResource GridCenterLineColor}" presentationoptions:Freeze="True"/>

    <!-- Dialog shadow effect -->
    <DropShadowEffect x:Key="DialogShadowEffect"
                      Color="{StaticResource DialogShadowColor}"
                      BlurRadius="16" ShadowDepth="2" Opacity="0.4"
                      Direction="270"/>

    <!-- Toast shadow effect -->
    <DropShadowEffect x:Key="ToastShadowEffect"
                      Color="{StaticResource ToastShadowColor}"
                      BlurRadius="12" ShadowDepth="2" Opacity="0.3"
                      Direction="270"/>

</ResourceDictionary>
