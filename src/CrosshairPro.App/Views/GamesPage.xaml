<UserControl x:Class="CrosshairPro.App.Views.GamesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:vm="clr-namespace:CrosshairPro.App.ViewModels"
      xmlns:models="clr-namespace:CrosshairPro.Core.Models;assembly=CrosshairPro.Core"
      mc:Ignorable="d"
      d:DesignHeight="500" d:DesignWidth="800">

    <Grid Margin="20,12,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 游戏选择器 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <ItemsControl ItemsSource="{Binding Games}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding DisplayName}"
                                Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                                Margin="0,0,8,0"
                                Padding="12,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- 游戏标题 -->
        <TextBlock Grid.Row="1" Text="{Binding SelectedGame.DisplayName}"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,12"/>

        <!-- 配置内容 -->
        <ScrollViewer Grid.Row="2" Style="{StaticResource CustomScrollViewer}">
            <StackPanel>
                <!-- 启动项 -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                        Visibility="{Binding CurrentStrategy.SupportsLaunchOptions, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="LAUNCH OPTIONS" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding CurrentStrategy.LaunchOptionsDescription}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Margin="0,0,0,8"/>
                        <TextBox Text="{Binding CurrentConfig.LaunchOptions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CustomTextBox}"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 Height="80" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

                <!-- 配置分区 -->
                <ItemsControl ItemsSource="{Binding CurrentStrategy.Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource SectionHeader}"/>

                                    <!-- 配置项 -->
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 配置项名称 -->
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Description}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                                   Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}"/>
                                                    </StackPanel>

                                                    <!-- 配置项控件 -->
                                                    <ContentControl Grid.Column="1" VerticalAlignment="Center" Width="150">
                                                        <ContentControl.Style>
                                                            <Style TargetType="ContentControl">
                                                                <Style.Triggers>
                                                                    <!-- Bool 类型 -->
                                                                    <DataTrigger Binding="{Binding Type}" Value="Bool">
                                                                        <Setter Property="ContentTemplate">
                                                                            <Setter.Value>
                                                                                <DataTemplate>
                                                                                    <CheckBox IsChecked="{Binding DataContext.CurrentConfig.Settings[Key], Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                                              Style="{StaticResource CustomCheckBox}"/>
                                                                                </DataTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>

                                                                    <!-- Int 类型 -->
                                                                    <DataTrigger Binding="{Binding Type}" Value="Int">
                                                                        <Setter Property="ContentTemplate">
                                                                            <Setter.Value>
                                                                                <DataTemplate>
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <Slider Grid.Column="0"
                                                                                                Value="{Binding DataContext.CurrentConfig.Settings[Key], Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                                                Minimum="{Binding MinValue}"
                                                                                                Maximum="{Binding MaxValue}"
                                                                                                Style="{StaticResource CustomSlider}"
                                                                                                Width="80"/>
                                                                                        <TextBox Grid.Column="1"
                                                                                                  Text="{Binding DataContext.CurrentConfig.Settings[Key], Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                                                  Style="{StaticResource NumericTextBox}"
                                                                                                  Width="50" Margin="8,0,0,0"/>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>

                                                                    <!-- Enum 类型 -->
                                                                    <DataTrigger Binding="{Binding Type}" Value="Enum">
                                                                        <Setter Property="ContentTemplate">
                                                                            <Setter.Value>
                                                                                <DataTemplate>
                                                                                    <ComboBox ItemsSource="{Binding Options}"
                                                                                              SelectedItem="{Binding DataContext.CurrentConfig.Settings[Key], Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                                              Style="{StaticResource CustomComboBox}"
                                                                                              Width="150"/>
                                                                                </DataTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>

                                                                    <!-- String 类型 -->
                                                                    <DataTrigger Binding="{Binding Type}" Value="String">
                                                                        <Setter Property="ContentTemplate">
                                                                            <Setter.Value>
                                                                                <DataTemplate>
                                                                                    <TextBox Text="{Binding DataContext.CurrentConfig.Settings[Key], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                                             Style="{StaticResource CustomTextBox}"
                                                                                             Width="150"/>
                                                                                </DataTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Reset"
                    Command="{Binding ResetConfigCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0"/>
            <Button Content="Apply"
                    Command="{Binding ApplyConfigCommand}"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</UserControl>