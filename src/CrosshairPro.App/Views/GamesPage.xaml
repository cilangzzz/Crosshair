<UserControl x:Class="CrosshairPro.App.Views.GamesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:CrosshairPro.App.Views.GamePages"
      xmlns:loc="clr-namespace:CrosshairPro.App.Localization"
      mc:Ignorable="d"
      d:DesignHeight="500" d:DesignWidth="800">

    <Grid Margin="20,12,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 游戏选择器（ComboBox 形态：预期游戏 10+，tab 条范式不适用，见 design/games-tab-overflow-design.md） -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="{loc:Loc Key=Games.SelectorLabel}" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="200"
                      Style="{StaticResource CustomComboBox}"
                      ItemsSource="{Binding Games}"
                      SelectedItem="{Binding SelectedGame, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource GameProfileTitleConverter}">
                                    <Binding Path="DisplayName"/>
                                    <Binding Path="DisplayNameLocKey"/>
                                    <Binding Path="CurrentCulture" Source="{x:Static loc:LocalizationProvider.Instance}"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!-- 游戏配置页面容器 -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentGameId}">
            <ContentControl.ContentTemplateSelector>
                <local:GamePageSelector>
                    <local:GamePageSelector.ApexTemplate>
                        <DataTemplate>
                            <local:ApexPage/>
                        </DataTemplate>
                    </local:GamePageSelector.ApexTemplate>
                    <local:GamePageSelector.Cs2Template>
                        <DataTemplate>
                            <local:Cs2Page/>
                        </DataTemplate>
                    </local:GamePageSelector.Cs2Template>
                    <local:GamePageSelector.PcOptimizeTemplate>
                        <DataTemplate>
                            <local:PcOptimizePage/>
                        </DataTemplate>
                    </local:GamePageSelector.PcOptimizeTemplate>
                    <local:GamePageSelector.DefaultTemplate>
                        <DataTemplate>
                            <TextBlock Text="{loc:Loc Key=Games.SelectPrompt}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </local:GamePageSelector.DefaultTemplate>
                </local:GamePageSelector>
            </ContentControl.ContentTemplateSelector>
        </ContentControl>
    </Grid>
</UserControl>
