<UserControl x:Class="CrosshairPro.App.Views.GamePages.Cs2Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:CrosshairPro.App.Controls"
      xmlns:loc="clr-namespace:CrosshairPro.App.Localization"
      xmlns:vm="clr-namespace:CrosshairPro.App.ViewModels"
      xmlns:game="clr-namespace:CrosshairPro.App.Views.GamePages"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=vm:Cs2ConfigViewModel}">

    <!-- 统一行模板：按 ConfigItemType 选择 开关/滑杆/下拉 行，保证与 Apex 页排版一致 -->
    <UserControl.Resources>
        <game:ConfigItemTemplateSelector x:Key="ConfigItemSelector">
            <game:ConfigItemTemplateSelector.BoolTemplate>
                <DataTemplate>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                   VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding Value, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"/>
                    </Grid>
                </DataTemplate>
            </game:ConfigItemTemplateSelector.BoolTemplate>
            <game:ConfigItemTemplateSelector.IntTemplate>
                <DataTemplate>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                   VerticalAlignment="Center"/>
                        <Slider Grid.Column="1"
                                Value="{Binding Value, Mode=TwoWay}"
                                Minimum="{Binding MinValue}"
                                Maximum="{Binding MaxValue}"
                                Style="{StaticResource CustomSlider}" Margin="8,0"/>
                        <TextBox Grid.Column="2"
                                 Text="{Binding Value, Mode=TwoWay}"
                                 Style="{StaticResource NumericTextBox}"/>
                    </Grid>
                </DataTemplate>
            </game:ConfigItemTemplateSelector.IntTemplate>
            <game:ConfigItemTemplateSelector.EnumTemplate>
                <DataTemplate>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Width="160"
                                  ItemsSource="{Binding Options}"
                                  SelectedItem="{Binding Value, Mode=TwoWay}"
                                  Style="{StaticResource CustomComboBox}"/>
                    </Grid>
                </DataTemplate>
            </game:ConfigItemTemplateSelector.EnumTemplate>
            <game:ConfigItemTemplateSelector.StringTemplate>
                <DataTemplate>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Width="240"
                                 Text="{Binding Value, Mode=TwoWay}"
                                 Style="{StaticResource CustomTextBox}"/>
                    </Grid>
                </DataTemplate>
            </game:ConfigItemTemplateSelector.StringTemplate>
        </game:ConfigItemTemplateSelector>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{loc:Loc Key=Cs2.Title}"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="{loc:Loc Key=Cs2.VideoFileNote}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="11"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 配置内容 -->
        <controls:SmoothScrollViewer Grid.Row="1" Style="{StaticResource SmoothScrollViewer}">
            <StackPanel>

                <!-- 视频设置（video.txt 字段） -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=Cs2.VideoSection}"
                                   Style="{StaticResource SectionHeader}"/>
                        <ItemsControl ItemsSource="{Binding Sections[0].Items}"
                                      ItemTemplateSelector="{StaticResource ConfigItemSelector}"/>
                    </StackPanel>
                </Border>

                <!-- 游戏设置（autoexec.cfg / config.cfg 字段） -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=Cs2.GameSection}"
                                   Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{loc:Loc Key=Cs2.AutoexecFileNote}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" Margin="0,4,0,0"/>
                        <ItemsControl ItemsSource="{Binding Sections[1].Items}"
                                      ItemTemplateSelector="{StaticResource ConfigItemSelector}"/>
                    </StackPanel>
                </Border>

                <!-- 启动项 -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=Cs2.LaunchSection}"
                                   Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{loc:Loc Key=Cs2.LaunchOptionsHint}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" Margin="0,4,0,12"
                                   TextWrapping="Wrap"/>

                        <TextBox Text="{Binding LaunchOptions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CustomTextBox}"
                                 AcceptsReturn="True" Height="80" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="{StaticResource FontFamilyMono}"
                                 FontSize="12"/>

                        <!-- 字符计数 -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LaunchOptionsSummary}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="{loc:Loc Key=Cs2.CopyToClipboard}"
                                    Command="{Binding CopyLaunchOptionsCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,4" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 配置管理（置于最下方） -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=Game.ConfigManagement}"
                                   Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{loc:Loc Key=Game.ConfigManagementDesc}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" Margin="0,4,0,12"/>

                        <!-- 本地配置文件 -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Key=Cs2.LocalConfigFile}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="{StaticResource FontFamilyMono}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ConfigFilePath}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="12,0,12,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="2"
                                    Content="{loc:Loc Key=Game.OpenConfigFolder}"
                                    Command="{Binding OpenConfigFolderCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="10,4" FontSize="12"/>
                        </Grid>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,12"/>

                        <!-- 生成配置文件 -->
                        <TextBlock Text="{loc:Loc Key=Cs2.GenerateConfigDesc}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" Margin="0,0,0,12"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{loc:Loc Key=Game.GenerateConfig}"
                                    Command="{Binding GenerateConfigFileCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,4" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 状态消息 -->
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12"
                           HorizontalAlignment="Right"
                           Margin="0,0,0,4"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>
        </controls:SmoothScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,16">
            <Button Content="{loc:Loc Key=Cs2.ResetToDefault}"
                    Command="{Binding ResetCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0"/>
            <Button Content="{loc:Loc Key=Cs2.SaveConfiguration}"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</UserControl>
