<UserControl x:Class="CrosshairPro.App.Views.GamePages.Cs2Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:CrosshairPro.App.Controls"
      xmlns:loc="clr-namespace:CrosshairPro.App.Localization"
      xmlns:vm="clr-namespace:CrosshairPro.App.ViewModels"
      xmlns:core="clr-namespace:CrosshairPro.Core.Models;assembly=CrosshairPro.Core"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=vm:Cs2ConfigViewModel}">

    <Grid Margin="20,12,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{loc:Loc Key=Cs2.Title}"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="{loc:Loc Key=Cs2.VideoFileNote}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="11"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 配置内容 -->
        <controls:SmoothScrollViewer Grid.Row="1" Style="{StaticResource SmoothScrollViewer}">
            <StackPanel>

                <!-- 视频设置（video.txt 字段） -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=Cs2.VideoSection}"
                                   Style="{StaticResource SectionHeader}"/>

                        <!-- 全屏 -->
                        <CheckBox Content="{loc:Loc Key=Cs2.Fullscreen}"
                                  IsChecked="{Binding Sections[0].Items[0].Value, Mode=TwoWay}"
                                  Style="{StaticResource CustomCheckBox}"
                                  Margin="0,8,0,0"/>

                        <!-- 分辨率 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="140"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Key=Cs2.Resolution}"
                                       VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Width="160"
                                      ItemsSource="{Binding Sections[0].Items[1].Options}"
                                      SelectedItem="{Binding Sections[0].Items[1].Value, Mode=TwoWay}"
                                      Style="{StaticResource CustomComboBox}"/>
                        </Grid>

                        <!-- 宽高比 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="140"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Key=Cs2.AspectRatio}"
                                       VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Width="120"
                                      ItemsSource="{Binding Sections[0].Items[2].Options}"
                                      SelectedItem="{Binding Sections[0].Items[2].Value, Mode=TwoWay}"
                                      Style="{StaticResource CustomComboBox}"/>
                        </Grid>

                        <!-- 刷新率 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Key=Cs2.RefreshRate}"
                                       VerticalAlignment="Center"/>
                            <Slider Grid.Column="1"
                                    Value="{Binding Sections[0].Items[3].Value, Mode=TwoWay}"
                                    Minimum="{Binding Sections[0].Items[3].MinValue}"
                                    Maximum="{Binding Sections[0].Items[3].MaxValue}"
                                    Style="{StaticResource CustomSlider}" Margin="8,0"/>
                            <TextBox Grid.Column="2"
                                     Text="{Binding Sections[0].Items[3].Value, Mode=TwoWay}"
                                     Style="{StaticResource NumericTextBox}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 游戏设置（autoexec.cfg / config.cfg 字段） -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=Cs2.GameSection}"
                                   Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{loc:Loc Key=Cs2.AutoexecFileNote}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" Margin="0,4,0,12"/>

                        <!-- fps_max -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Key=Cs2.MaxFps}"
                                       VerticalAlignment="Center"/>
                            <Slider Grid.Column="1"
                                    Value="{Binding Sections[1].Items[0].Value, Mode=TwoWay}"
                                    Minimum="{Binding Sections[1].Items[0].MinValue}"
                                    Maximum="{Binding Sections[1].Items[0].MaxValue}"
                                    Style="{StaticResource CustomSlider}" Margin="8,0"/>
                            <TextBox Grid.Column="2"
                                     Text="{Binding Sections[1].Items[0].Value, Mode=TwoWay}"
                                     Style="{StaticResource NumericTextBox}"/>
                        </Grid>

                        <!-- cl_showfps -->
                        <CheckBox Content="{loc:Loc Key=Cs2.ShowFps}"
                                  IsChecked="{Binding Sections[1].Items[1].Value, Mode=TwoWay}"
                                  Style="{StaticResource CustomCheckBox}"
                                  Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 启动项 -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=Cs2.LaunchSection}"
                                   Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{loc:Loc Key=Cs2.LaunchOptionsHint}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" Margin="0,4,0,12"
                                   TextWrapping="Wrap"/>

                        <TextBox Text="{Binding LaunchOptions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CustomTextBox}"
                                 AcceptsReturn="True" Height="80" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="{StaticResource FontFamilyMono}"
                                 FontSize="12"/>

                        <!-- 字符计数 -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LaunchOptionsSummary}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="{loc:Loc Key=Cs2.CopyToClipboard}"
                                    Command="{Binding CopyLaunchOptionsCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,4" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 状态消息 -->
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12"
                           HorizontalAlignment="Right"
                           Margin="0,0,0,4"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>
        </controls:SmoothScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Loc Key=Apex.ResetToDefault}"
                    Command="{Binding ResetCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0"/>
            <Button Content="{loc:Loc Key=Apex.SaveConfiguration}"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</UserControl>