<UserControl x:Class="CrosshairPro.App.Views.GamePages.ApexPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:CrosshairPro.App.Controls"
      xmlns:loc="clr-namespace:CrosshairPro.App.Localization"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="800">

    <Grid Margin="20,12,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="{loc:Loc Apex.Title}"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentBrush}"
                   Margin="0,0,0,16"/>

        <!-- 配置内容 -->
        <controls:SmoothScrollViewer Grid.Row="1" Style="{StaticResource SmoothScrollViewer}">
            <StackPanel>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- 配置文件管理 -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Apex.ConfigFiles}" Style="{StaticResource SectionHeader}"/>

                        <!-- videoconfig.txt -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="videoconfig.txt"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="{StaticResource FontFamilyMono}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding VideoConfigPath}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="12,0,12,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="{loc:Loc Action.Replace}" Command="{Binding ReplaceVideoConfigCommand}"
                                        Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="12" Margin="0,0,4,0"/>
                                <Button Content="{loc:Loc Action.Backup}" Command="{Binding BackupVideoConfigCommand}"
                                        Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="12" Margin="0,0,4,0"/>
                                <Button Content="{loc:Loc Action.Export}" Command="{Binding ExportVideoConfigCommand}"
                                        Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="12" Margin="0,0,4,0"/>
                                <Button Content="{loc:Loc Action.History}" Command="{Binding ToggleVideoConfigHistoryCommand}"
                                        Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <!-- videoconfig.txt 历史记录 -->
                        <Border Background="{DynamicResource ControlBrush}"
                                CornerRadius="{StaticResource RadiusSm}"
                                Padding="8" Margin="0,8,0,0"
                                Visibility="{Binding ShowVideoConfigHistory, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc History.BackupHistory}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding VideoConfigBackups}" MaxHeight="150">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayTime}" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text=" • " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DisplaySize}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{loc:Loc Action.Restore}"
                                                        Command="{Binding DataContext.RestoreVideoConfigBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="11" Margin="0,0,4,0"/>
                                                <Button Grid.Column="2" Content="×"
                                                        Command="{Binding DataContext.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="11"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{loc:Loc History.NoBackups}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                           Visibility="{Binding VideoConfigBackups.Count, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>

                        <!-- 分隔线 -->
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,12"/>

                        <!-- settings.cfg -->
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="settings.cfg"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="{StaticResource FontFamilyMono}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SettingsConfigPath}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="12,0,12,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="{loc:Loc Action.Replace}" Command="{Binding ReplaceSettingsConfigCommand}"
                                        Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="12" Margin="0,0,4,0"/>
                                <Button Content="{loc:Loc Action.Backup}" Command="{Binding BackupSettingsConfigCommand}"
                                        Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="12" Margin="0,0,4,0"/>
                                <Button Content="{loc:Loc Action.Export}" Command="{Binding ExportSettingsConfigCommand}"
                                        Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="12" Margin="0,0,4,0"/>
                                <Button Content="{loc:Loc Action.History}" Command="{Binding ToggleSettingsConfigHistoryCommand}"
                                        Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <!-- settings.cfg 历史记录 -->
                        <Border Background="{DynamicResource ControlBrush}"
                                CornerRadius="{StaticResource RadiusSm}"
                                Padding="8" Margin="0,8,0,0"
                                Visibility="{Binding ShowSettingsConfigHistory, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc History.BackupHistory}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding SettingsConfigBackups}" MaxHeight="150">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayTime}" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text=" • " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DisplaySize}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{loc:Loc Action.Restore}"
                                                        Command="{Binding DataContext.RestoreSettingsConfigBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="11" Margin="0,0,4,0"/>
                                                <Button Grid.Column="2" Content="×"
                                                        Command="{Binding DataContext.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="11"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{loc:Loc History.NoBackups}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                           Visibility="{Binding SettingsConfigBackups.Count, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- 启动选项 -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Apex.LaunchOptions}" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{loc:Loc Apex.LaunchOptionsDesc}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,12"/>

                        <!-- 预设选择 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Apex.Preset}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding LaunchOptionPresets}"
                                      SelectedIndex="{Binding SelectedLaunchPresetIndex, Mode=TwoWay}"
                                      Style="{StaticResource CustomComboBox}"/>
                        </Grid>

                        <!-- 简单文本框（非自定义模式） -->
                        <TextBox Text="{Binding LaunchOptions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CustomTextBox}"
                                 AcceptsReturn="True" Height="60" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"
                                 Visibility="{Binding UseCustomLaunchOptions, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                        <!-- 自定义启动选项展开面板 -->
                        <Border Background="{DynamicResource ControlBrush}"
                                CornerRadius="{StaticResource RadiusSm}" Padding="12"
                                Visibility="{Binding UseCustomLaunchOptions, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Apex.CustomLaunchOptions}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <!-- Performance -->
                                <TextBlock Text="{loc:Loc Apex.Performance}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                                <CheckBox Content="{loc:Loc Apex.HighPriority}" IsChecked="{Binding CustomLaunchOptions.High, Mode=TwoWay}" Margin="0,4"/>
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Apex.Threads}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Value="{Binding CustomLaunchOptions.Threads, Mode=TwoWay}"
                                            Minimum="0" Maximum="16" Style="{StaticResource CustomSlider}" Margin="8,0"/>
                                    <TextBox Grid.Column="2" Text="{Binding CustomLaunchOptions.Threads, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Apex.RefreshRate}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Value="{Binding CustomLaunchOptions.Freq, Mode=TwoWay}"
                                            Minimum="0" Maximum="360" Style="{StaticResource CustomSlider}" Margin="8,0"/>
                                    <TextBox Grid.Column="2" Text="{Binding CustomLaunchOptions.Freq, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                                </Grid>
                                <CheckBox Content="{loc:Loc Apex.SkipIntro}" IsChecked="{Binding CustomLaunchOptions.Novid, Mode=TwoWay}" Margin="0,4"/>
                                <CheckBox Content="{loc:Loc Apex.DisableJoystick}" IsChecked="{Binding CustomLaunchOptions.Nojoy, Mode=TwoWay}" Margin="0,4,0,12"/>

                                <!-- Window -->
                                <TextBlock Text="{loc:Loc Apex.Window}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                                <CheckBox Content="{loc:Loc Apex.WindowedMode}" IsChecked="{Binding CustomLaunchOptions.Windowed, Mode=TwoWay}" Margin="0,4"/>
                                <CheckBox Content="{loc:Loc Apex.BorderlessWindow}" IsChecked="{Binding CustomLaunchOptions.Noborder, Mode=TwoWay}" Margin="0,4"/>
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Apex.WindowWidth}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Value="{Binding CustomLaunchOptions.Width, Mode=TwoWay}"
                                            Minimum="800" Maximum="3840" Style="{StaticResource CustomSlider}" Margin="8,0"/>
                                    <TextBox Grid.Column="2" Text="{Binding CustomLaunchOptions.Width, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Apex.WindowHeight}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Value="{Binding CustomLaunchOptions.Height, Mode=TwoWay}"
                                            Minimum="600" Maximum="2160" Style="{StaticResource CustomSlider}" Margin="8,0"/>
                                    <TextBox Grid.Column="2" Text="{Binding CustomLaunchOptions.Height, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                                </Grid>

                                <!-- Game Settings -->
                                <TextBlock Text="{loc:Loc Apex.GameSettings}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Apex.MaxFPS}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Value="{Binding CustomLaunchOptions.FpsMax, Mode=TwoWay}"
                                            Minimum="0" Maximum="300" Style="{StaticResource CustomSlider}" Margin="8,0"/>
                                    <TextBox Grid.Column="2" Text="{Binding CustomLaunchOptions.FpsMax, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                                </Grid>
                                <CheckBox Content="{loc:Loc Apex.ShowPositionInfo}" IsChecked="{Binding CustomLaunchOptions.ClShowpos, Mode=TwoWay}" Margin="0,4"/>
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Apex.FOVScale}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Value="{Binding CustomLaunchOptions.ClFovScale, Mode=TwoWay}"
                                            Minimum="1.0" Maximum="1.35" SmallChange="0.01" LargeChange="0.05"
                                            Style="{StaticResource CustomSlider}" Margin="8,0"/>
                                    <TextBox Grid.Column="2" Text="{Binding CustomLaunchOptions.ClFovScale, StringFormat={}{0:F2}, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Apex.LetterboxAspect}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Value="{Binding CustomLaunchOptions.MatLetterboxAspectMin, Mode=TwoWay}"
                                            Minimum="0" Maximum="2.0" SmallChange="0.1" LargeChange="0.1"
                                            Style="{StaticResource CustomSlider}" Margin="8,0"/>
                                    <TextBox Grid.Column="2" Text="{Binding CustomLaunchOptions.MatLetterboxAspectMin, StringFormat={}{0:F1}, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                                </Grid>

                                <!-- Network -->
                                <TextBlock Text="{loc:Loc Apex.Network}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Apex.Interp}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Value="{Binding CustomLaunchOptions.ClInterp, Mode=TwoWay}"
                                            Minimum="0" Maximum="0.1" SmallChange="0.001" LargeChange="0.01"
                                            Style="{StaticResource CustomSlider}" Margin="8,0"/>
                                    <TextBox Grid.Column="2" Text="{Binding CustomLaunchOptions.ClInterp, StringFormat={}{0:F3}, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Apex.InterpRatio}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Value="{Binding CustomLaunchOptions.ClInterpRatio, Mode=TwoWay}"
                                            Minimum="1" Maximum="10" Style="{StaticResource CustomSlider}" Margin="8,0"/>
                                    <TextBox Grid.Column="2" Text="{Binding CustomLaunchOptions.ClInterpRatio, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                                </Grid>

                                <!-- Debug -->
                                <TextBlock Text="{loc:Loc Apex.Debug}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                                <CheckBox Content="{loc:Loc Apex.DevMode}" IsChecked="{Binding CustomLaunchOptions.Dev, Mode=TwoWay}" Margin="0,4"/>
                                <CheckBox Content="{loc:Loc Apex.EnableConsole}" IsChecked="{Binding CustomLaunchOptions.Console, Mode=TwoWay}" Margin="0,4"/>

                                <!-- 汇总显示 -->
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSm}" Padding="8" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Apex.GeneratedLaunchOptions}" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding LaunchOptionsSummary}" TextWrapping="Wrap"
                                                   FontFamily="{StaticResource FontFamilyMono}" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Button Content="{loc:Loc Action.CopyToClipboard}" Command="{Binding CopyLaunchOptionsCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Padding="12,4" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- 视频设置 -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Apex.VideoSettings}" Style="{StaticResource SectionHeader}"/>

                        <!-- 分辨率 -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Apex.Resolution}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Width="160"
                                      SelectedIndex="{Binding VideoConfig.ResolutionIndex, Mode=TwoWay}"
                                      Style="{StaticResource CustomComboBox}">
                                <ComboBoxItem Content="3840x2160"/>
                                <ComboBoxItem Content="2560x1600"/>
                                <ComboBoxItem Content="2560x1440"/>
                                <ComboBoxItem Content="2560x1080"/>
                                <ComboBoxItem Content="1920x1200"/>
                                <ComboBoxItem Content="1920x1080"/>
                                <ComboBoxItem Content="1680x1050"/>
                                <ComboBoxItem Content="1600x900"/>
                                <ComboBoxItem Content="1440x900"/>
                                <ComboBoxItem Content="1280x1024"/>
                                <ComboBoxItem Content="1280x960"/>
                                <ComboBoxItem Content="1280x800"/>
                                <ComboBoxItem Content="1280x720"/>
                            </ComboBox>
                        </Grid>

                        <!-- 刷新率 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Refresh Rate (Hz)" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Value="{Binding VideoConfig.RefreshRate, Mode=TwoWay}"
                                    Minimum="60" Maximum="360" Style="{StaticResource CustomSlider}" Margin="8,0"/>
                            <TextBox Grid.Column="2" Text="{Binding VideoConfig.RefreshRate, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                        </Grid>

                        <!-- 亮度/伽马 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Apex.Gamma}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Value="{Binding VideoConfig.Gamma, Mode=TwoWay}"
                                    Minimum="0.5" Maximum="2.5" SmallChange="0.1" LargeChange="0.1"
                                    Style="{StaticResource CustomSlider}" Margin="8,0"/>
                            <TextBox Grid.Column="2" Text="{Binding VideoConfig.Gamma, StringFormat={}{0:F1}, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- 画质设置 -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Apex.QualitySettings}" Style="{StaticResource SectionHeader}"/>

                        <!-- 纹理质量 -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Apex.TextureQuality}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Width="160"
                                      SelectedIndex="{Binding VideoConfig.MatPicmip, Mode=TwoWay}"
                                      Style="{StaticResource CustomComboBox}">
                                <ComboBoxItem Content="{loc:Loc Quality.Highest}"/>
                                <ComboBoxItem Content="{loc:Loc Quality.High}"/>
                                <ComboBoxItem Content="{loc:Loc Quality.Medium}"/>
                                <ComboBoxItem Content="{loc:Loc Quality.Low}"/>
                            </ComboBox>
                        </Grid>

                        <!-- 各向异性过滤 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Apex.AnisotropicFiltering}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Value="{Binding VideoConfig.MatForceaniso, Mode=TwoWay}"
                                    Minimum="1" Maximum="16" Style="{StaticResource CustomSlider}" Margin="8,0"/>
                            <TextBox Grid.Column="2" Text="{Binding VideoConfig.MatForceaniso, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                        </Grid>

                        <!-- 阴影 -->
                        <CheckBox Content="{loc:Loc Apex.EnableShadows}"
                                  IsChecked="{Binding VideoConfig.ShadowEnable, Converter={StaticResource IntToBoolConverter}, Mode=TwoWay}"
                                  Margin="0,12,0,0"/>
                        <CheckBox Content="{loc:Loc Apex.CascadeShadowMaps}"
                                  IsChecked="{Binding VideoConfig.CsmEnabled, Converter={StaticResource IntToBoolConverter}, Mode=TwoWay}"
                                  Margin="24,4,0,0"/>

                        <!-- 粒子效果 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Apex.ParticleEffects}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Width="160"
                                      SelectedIndex="{Binding VideoConfig.ParticleCpuLevel, Mode=TwoWay}"
                                      Style="{StaticResource CustomComboBox}">
                                <ComboBoxItem Content="{loc:Loc Quality.Low}"/>
                                <ComboBoxItem Content="{loc:Loc Quality.Medium}"/>
                                <ComboBoxItem Content="{loc:Loc Quality.High}"/>
                            </ComboBox>
                        </Grid>

                        <!-- SSAO -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Apex.AmbientOcclusion}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Width="160"
                                      SelectedIndex="{Binding VideoConfig.SsaoQuality, Mode=TwoWay}"
                                      Style="{StaticResource CustomComboBox}">
                                <ComboBoxItem Content="{loc:Loc Quality.Off}"/>
                                <ComboBoxItem Content="Low"/>
                                <ComboBoxItem Content="High"/>
                            </ComboBox>
                        </Grid>

                        <!-- 体积效果 -->
                        <CheckBox Content="{loc:Loc Apex.VolumetricLighting}"
                                  IsChecked="{Binding VideoConfig.VolumetricLighting, Converter={StaticResource IntToBoolConverter}, Mode=TwoWay}"
                                  Margin="0,12,0,0"/>
                        <CheckBox Content="{loc:Loc Apex.VolumetricFog}"
                                  IsChecked="{Binding VideoConfig.VolumetricFog, Converter={StaticResource IntToBoolConverter}, Mode=TwoWay}"
                                  Margin="0,8,0,0"/>

                        <!-- 物理效果 -->
                        <CheckBox Content="{loc:Loc Apex.RagdollPhysics}"
                                  IsChecked="{Binding VideoConfig.ClGibAllow, Converter={StaticResource IntToBoolConverter}, Mode=TwoWay}"
                                  Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- 性能设置 -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Apex.PerformanceSection}" Style="{StaticResource SectionHeader}"/>

                        <!-- 垂直同步 -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Apex.VSync}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Width="160"
                                      SelectedIndex="{Binding VideoConfig.MatVsyncMode, Mode=TwoWay}"
                                      Style="{StaticResource CustomComboBox}">
                                <ComboBoxItem Content="{loc:Loc Quality.Off}"/>
                                <ComboBoxItem Content="{loc:Loc Quality.On}"/>
                                <ComboBoxItem Content="{loc:Loc Quality.TripleBuffered}"/>
                            </ComboBox>
                        </Grid>

                        <!-- 抗锯齿 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Apex.AntiAliasing}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Width="160"
                                      SelectedIndex="{Binding VideoConfig.MatAntialiasMode, Mode=TwoWay}"
                                      Style="{StaticResource CustomComboBox}">
                                <ComboBoxItem Content="{loc:Loc Quality.Off}"/>
                                <ComboBoxItem Content="FXAA"/>
                                <ComboBoxItem Content="TXAA"/>
                                <ComboBoxItem Content="MSAA 2x"/>
                                <ComboBoxItem Content="MSAA 4x"/>
                            </ComboBox>
                        </Grid>

                        <!-- 动态分辨率 -->
                        <CheckBox Content="{loc:Loc Apex.DynamicResolution}"
                                  IsChecked="{Binding VideoConfig.DvsEnable, Converter={StaticResource IntToBoolConverter}, Mode=TwoWay}"
                                  Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- 游戏设置 -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Apex.GameSettings}" Style="{StaticResource SectionHeader}"/>

                        <!-- 鼠标灵敏度 -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Apex.MouseSensitivity}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Value="{Binding SettingsConfig.MouseSensitivity, Mode=TwoWay}"
                                    Minimum="0.1" Maximum="10.0" SmallChange="0.1" LargeChange="0.5"
                                    Style="{StaticResource CustomSlider}" Margin="8,0"/>
                            <TextBox Grid.Column="2" Text="{Binding SettingsConfig.MouseSensitivity, StringFormat={}{0:F2}, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                        </Grid>

                        <!-- 鼠标加速 -->
                        <CheckBox Content="{loc:Loc Apex.MouseAcceleration}"
                                  IsChecked="{Binding SettingsConfig.MAcceleration, Converter={StaticResource IntToBoolConverter}, Mode=TwoWay}"
                                  Margin="0,12,0,0"/>

                        <!-- FOV -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Apex.FieldOfView}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Value="{Binding SettingsConfig.ClFovScale, Mode=TwoWay}"
                                    Minimum="1.0" Maximum="1.35" SmallChange="0.01" LargeChange="0.05"
                                    Style="{StaticResource CustomSlider}" Margin="8,0"/>
                            <TextBox Grid.Column="2" Text="{Binding SettingsConfig.ClFovScale, StringFormat={}{0:F2}, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                        </Grid>

                        <!-- FPS -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Apex.MaxFPS}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Value="{Binding SettingsConfig.FpsMax, Mode=TwoWay}"
                                    Minimum="0" Maximum="300" Style="{StaticResource CustomSlider}" Margin="8,0"/>
                            <TextBox Grid.Column="2" Text="{Binding SettingsConfig.FpsMax, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                        </Grid>

                        <!-- 显示选项 -->
                        <CheckBox Content="{loc:Loc Apex.ShowFPS}"
                                  IsChecked="{Binding SettingsConfig.ClShowfps, Converter={StaticResource IntToBoolConverter}, Mode=TwoWay}"
                                  Margin="0,12,0,0"/>
                        <CheckBox Content="{loc:Loc Apex.ShowPosition}"
                                  IsChecked="{Binding SettingsConfig.ClShowpos, Converter={StaticResource IntToBoolConverter}, Mode=TwoWay}"
                                  Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- 瞄准镜灵敏度 -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox Content="{loc:Loc Apex.PerScopeSensitivity}"
                                  IsChecked="{Binding SettingsConfig.MouseUsePerScopeSensitivityScalars, Converter={StaticResource IntToBoolConverter}, Mode=TwoWay}"
                                  Style="{StaticResource CustomCheckBox}" Margin="0,0,0,12"/>

                        <!-- 1x -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Apex.Scope1x}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Value="{Binding SettingsConfig.MouseZoomedSensitivityScalar0, Mode=TwoWay}"
                                    Minimum="0.1" Maximum="2.0" SmallChange="0.1" LargeChange="0.1"
                                    Style="{StaticResource CustomSlider}" Margin="8,0"/>
                            <TextBox Grid.Column="2" Text="{Binding SettingsConfig.MouseZoomedSensitivityScalar0, StringFormat={}{0:F1}, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                        </Grid>

                        <!-- 2x -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Apex.Scope2x}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Value="{Binding SettingsConfig.MouseZoomedSensitivityScalar1, Mode=TwoWay}"
                                    Minimum="0.1" Maximum="2.0" SmallChange="0.1" LargeChange="0.1"
                                    Style="{StaticResource CustomSlider}" Margin="8,0"/>
                            <TextBox Grid.Column="2" Text="{Binding SettingsConfig.MouseZoomedSensitivityScalar1, StringFormat={}{0:F1}, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                        </Grid>

                        <!-- 3x -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Apex.Scope3x}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Value="{Binding SettingsConfig.MouseZoomedSensitivityScalar2, Mode=TwoWay}"
                                    Minimum="0.1" Maximum="2.0" SmallChange="0.1" LargeChange="0.1"
                                    Style="{StaticResource CustomSlider}" Margin="8,0"/>
                            <TextBox Grid.Column="2" Text="{Binding SettingsConfig.MouseZoomedSensitivityScalar2, StringFormat={}{0:F1}, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                        </Grid>

                        <!-- 4x -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Apex.Scope4x}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Value="{Binding SettingsConfig.MouseZoomedSensitivityScalar3, Mode=TwoWay}"
                                    Minimum="0.1" Maximum="2.0" SmallChange="0.1" LargeChange="0.1"
                                    Style="{StaticResource CustomSlider}" Margin="8,0"/>
                            <TextBox Grid.Column="2" Text="{Binding SettingsConfig.MouseZoomedSensitivityScalar3, StringFormat={}{0:F1}, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                        </Grid>

                        <!-- 6x -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Apex.Scope6x}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Value="{Binding SettingsConfig.MouseZoomedSensitivityScalar4, Mode=TwoWay}"
                                    Minimum="0.1" Maximum="2.0" SmallChange="0.1" LargeChange="0.1"
                                    Style="{StaticResource CustomSlider}" Margin="8,0"/>
                            <TextBox Grid.Column="2" Text="{Binding SettingsConfig.MouseZoomedSensitivityScalar4, StringFormat={}{0:F1}, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                        </Grid>

                        <!-- 8x/10x -->
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Apex.Scope8x10x}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Value="{Binding SettingsConfig.MouseZoomedSensitivityScalar5, Mode=TwoWay}"
                                    Minimum="0.1" Maximum="2.0" SmallChange="0.1" LargeChange="0.1"
                                    Style="{StaticResource CustomSlider}" Margin="8,0"/>
                            <TextBox Grid.Column="2" Text="{Binding SettingsConfig.MouseZoomedSensitivityScalar5, StringFormat={}{0:F1}, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- 预设 -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Apex.Presets}" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="{loc:Loc Apex.Preset.Competitive}" Command="{Binding ApplyPresetCommand}" CommandParameter="竞技优化"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="12,6"/>
                            <Button Content="{loc:Loc Apex.Preset.HighQuality}" Command="{Binding ApplyPresetCommand}" CommandParameter="高画质"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="12,6"/>
                            <Button Content="{loc:Loc Apex.Preset.Default}" Command="{Binding ApplyPresetCommand}" CommandParameter="默认"
                                    Style="{StaticResource SecondaryButton}" Padding="12,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </controls:SmoothScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Loc Apex.ResetToDefault}" Command="{Binding ResetCommand}"
                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
            <Button Content="{loc:Loc Apex.SaveConfiguration}" Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</UserControl>