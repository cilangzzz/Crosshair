<UserControl x:Class="CrosshairPro.App.Views.GamePages.ApexPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:CrosshairPro.App.Controls"
      xmlns:loc="clr-namespace:CrosshairPro.App.Localization"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="800">

    <Grid Margin="20,12,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 鏍囬 -->
        <TextBlock Grid.Row="0" Text="{loc:Loc Key=Apex.Title}"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentBrush}"
                   Margin="0,0,0,16"/>

        <!-- 閰嶇疆鍐呭 -->
        <controls:SmoothScrollViewer Grid.Row="1" Style="{StaticResource SmoothScrollViewer}">
            <StackPanel>

                <!-- 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?-->
                <!-- 閰嶇疆鏂囦欢绠＄悊 -->
                <!-- 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?-->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=Apex.ConfigFiles}" Style="{StaticResource SectionHeader}"/>

                        <!-- videoconfig.txt -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="videoconfig.txt"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="{StaticResource FontFamilyMono}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding VideoConfigPath}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="12,0,12,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="{loc:Loc Key=Action.Replace}" Command="{Binding ReplaceVideoConfigCommand}"
                                        Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="12" Margin="0,0,4,0"/>
                                <Button Content="{loc:Loc Key=Action.Backup}" Command="{Binding BackupVideoConfigCommand}"
                                        Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="12" Margin="0,0,4,0"/>
                                <Button Content="{loc:Loc Key=Action.Export}" Command="{Binding ExportVideoConfigCommand}"
                                        Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="12" Margin="0,0,4,0"/>
                                <Button Content="{loc:Loc Key=Action.History}" Command="{Binding ToggleVideoConfigHistoryCommand}"
                                        Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <!-- videoconfig.txt 鍘嗗彶璁板綍 -->
                        <Border Background="{DynamicResource ControlBrush}"
                                CornerRadius="{StaticResource RadiusSm}"
                                Padding="8" Margin="0,8,0,0"
                                Visibility="{Binding ShowVideoConfigHistory, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=History.BackupHistory}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding VideoConfigBackups}" MaxHeight="150">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayTime}" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text=" 鈥?" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DisplaySize}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{loc:Loc Key=Action.Restore}"
                                                        Command="{Binding DataContext.RestoreVideoConfigBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="11" Margin="0,0,4,0"/>
                                                <Button Grid.Column="2" Content="脳"
                                                        Command="{Binding DataContext.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="11"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{loc:Loc Key=History.NoBackups}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                           Visibility="{Binding VideoConfigBackups.Count, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>

                        <!-- 鍒嗛殧绾?-->
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,12"/>

                        <!-- settings.cfg -->
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="settings.cfg"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="{StaticResource FontFamilyMono}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SettingsConfigPath}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="12,0,12,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="{loc:Loc Key=Action.Replace}" Command="{Binding ReplaceSettingsConfigCommand}"
                                        Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="12" Margin="0,0,4,0"/>
                                <Button Content="{loc:Loc Key=Action.Backup}" Command="{Binding BackupSettingsConfigCommand}"
                                        Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="12" Margin="0,0,4,0"/>
                                <Button Content="{loc:Loc Key=Action.Export}" Command="{Binding ExportSettingsConfigCommand}"
                                        Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="12" Margin="0,0,4,0"/>
                                <Button Content="{loc:Loc Key=Action.History}" Command="{Binding ToggleSettingsConfigHistoryCommand}"
                                        Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <!-- settings.cfg 鍘嗗彶璁板綍 -->
                        <Border Background="{DynamicResource ControlBrush}"
                                CornerRadius="{StaticResource RadiusSm}"
                                Padding="8" Margin="0,8,0,0"
                                Visibility="{Binding ShowSettingsConfigHistory, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=History.BackupHistory}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding SettingsConfigBackups}" MaxHeight="150">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayTime}" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text=" 鈥?" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DisplaySize}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{loc:Loc Key=Action.Restore}"
                                                        Command="{Binding DataContext.RestoreSettingsConfigBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="11" Margin="0,0,4,0"/>
                                                <Button Grid.Column="2" Content="脳"
                                                        Command="{Binding DataContext.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="11"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{loc:Loc Key=History.NoBackups}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                           Visibility="{Binding SettingsConfigBackups.Count, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?-->
                <!-- 鍚姩閫夐」 -->
                <!-- 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?-->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=Apex.LaunchOptions}" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{loc:Loc Key=Apex.LaunchOptionsDesc}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,12"/>

                        <!-- 棰勮閫夋嫨 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Key=Apex.Preset}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding LaunchOptionPresets}"
                                      SelectedIndex="{Binding SelectedLaunchPresetIndex, Mode=TwoWay}"
                                      Style="{StaticResource CustomComboBox}"/>
                        </Grid>

                        <!-- 绠€鍗曟枃鏈锛堥潪鑷畾涔夋ā寮忥級 -->
                        <TextBox Text="{Binding LaunchOptions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CustomTextBox}"
                                 AcceptsReturn="True" Height="60" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"
                                 Visibility="{Binding UseCustomLaunchOptions, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                        <!-- 鑷畾涔夊惎鍔ㄩ€夐」灞曞紑闈㈡澘 -->
                        <Border Background="{DynamicResource ControlBrush}"
                                CornerRadius="{StaticResource RadiusSm}" Padding="12"
                                Visibility="{Binding UseCustomLaunchOptions, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=Apex.CustomLaunchOptions}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <!-- Performance -->
                                <TextBlock Text="{loc:Loc Key=Apex.Performance}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                                <CheckBox Content="{loc:Loc Key=Apex.HighPriority}" IsChecked="{Binding CustomLaunchOptions.High, Mode=TwoWay}" Margin="0,4"/>
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Key=Apex.Threads}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Value="{Binding CustomLaunchOptions.Threads, Mode=TwoWay}"
                                            Minimum="0" Maximum="16" Style="{StaticResource CustomSlider}" Margin="8,0"/>
                                    <TextBox Grid.Column="2" Text="{Binding CustomLaunchOptions.Threads, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Key=Apex.RefreshRate}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Value="{Binding CustomLaunchOptions.Freq, Mode=TwoWay}"
                                            Minimum="0" Maximum="360" Style="{StaticResource CustomSlider}" Margin="8,0"/>
                                    <TextBox Grid.Column="2" Text="{Binding CustomLaunchOptions.Freq, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                                </Grid>
                                <CheckBox Content="{loc:Loc Key=Apex.SkipIntro}" IsChecked="{Binding CustomLaunchOptions.Novid, Mode=TwoWay}" Margin="0,4"/>
                                <CheckBox Content="{loc:Loc Key=Apex.DisableJoystick}" IsChecked="{Binding CustomLaunchOptions.Nojoy, Mode=TwoWay}" Margin="0,4,0,12"/>

                                <!-- Window -->
                                <TextBlock Text="{loc:Loc Key=Apex.Window}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                                <CheckBox Content="{loc:Loc Key=Apex.WindowedMode}" IsChecked="{Binding CustomLaunchOptions.Windowed, Mode=TwoWay}" Margin="0,4"/>
                                <CheckBox Content="{loc:Loc Key=Apex.BorderlessWindow}" IsChecked="{Binding CustomLaunchOptions.Noborder, Mode=TwoWay}" Margin="0,4"/>
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Key=Apex.WindowWidth}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Value="{Binding CustomLaunchOptions.Width, Mode=TwoWay}"
                                            Minimum="800" Maximum="3840" Style="{StaticResource CustomSlider}" Margin="8,0"/>
                                    <TextBox Grid.Column="2" Text="{Binding CustomLaunchOptions.Width, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Key=Apex.WindowHeight}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Value="{Binding CustomLaunchOptions.Height, Mode=TwoWay}"
                                            Minimum="600" Maximum="2160" Style="{StaticResource CustomSlider}" Margin="8,0"/>
                                    <TextBox Grid.Column="2" Text="{Binding CustomLaunchOptions.Height, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                                </Grid>

                                <!-- Game Settings -->
                                <TextBlock Text="{loc:Loc Key=Apex.GameSettings}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Key=Apex.MaxFPS}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Value="{Binding CustomLaunchOptions.FpsMax, Mode=TwoWay}"
                                            Minimum="0" Maximum="300" Style="{StaticResource CustomSlider}" Margin="8,0"/>
                                    <TextBox Grid.Column="2" Text="{Binding CustomLaunchOptions.FpsMax, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                                </Grid>
                                <CheckBox Content="{loc:Loc Key=Apex.ShowPositionInfo}" IsChecked="{Binding CustomLaunchOptions.ClShowpos, Mode=TwoWay}" Margin="0,4"/>
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Key=Apex.FOVScale}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Value="{Binding CustomLaunchOptions.ClFovScale, Mode=TwoWay}"
                                            Minimum="1.0" Maximum="1.35" SmallChange="0.01" LargeChange="0.05"
                                            Style="{StaticResource CustomSlider}" Margin="8,0"/>
                                    <TextBox Grid.Column="2" Text="{Binding CustomLaunchOptions.ClFovScale, StringFormat={}{0:F2}, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Key=Apex.LetterboxAspect}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Value="{Binding CustomLaunchOptions.MatLetterboxAspectMin, Mode=TwoWay}"
                                            Minimum="0" Maximum="2.0" SmallChange="0.1" LargeChange="0.1"
                                            Style="{StaticResource CustomSlider}" Margin="8,0"/>
                                    <TextBox Grid.Column="2" Text="{Binding CustomLaunchOptions.MatLetterboxAspectMin, StringFormat={}{0:F1}, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                                </Grid>

                                <!-- Network -->
                                <TextBlock Text="{loc:Loc Key=Apex.Network}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Key=Apex.Interp}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Value="{Binding CustomLaunchOptions.ClInterp, Mode=TwoWay}"
                                            Minimum="0" Maximum="0.1" SmallChange="0.001" LargeChange="0.01"
                                            Style="{StaticResource CustomSlider}" Margin="8,0"/>
                                    <TextBox Grid.Column="2" Text="{Binding CustomLaunchOptions.ClInterp, StringFormat={}{0:F3}, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Key=Apex.InterpRatio}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Value="{Binding CustomLaunchOptions.ClInterpRatio, Mode=TwoWay}"
                                            Minimum="1" Maximum="10" Style="{StaticResource CustomSlider}" Margin="8,0"/>
                                    <TextBox Grid.Column="2" Text="{Binding CustomLaunchOptions.ClInterpRatio, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                                </Grid>

                                <!-- Debug -->
                                <TextBlock Text="{loc:Loc Key=Apex.Debug}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                                <CheckBox Content="{loc:Loc Key=Apex.DevMode}" IsChecked="{Binding CustomLaunchOptions.Dev, Mode=TwoWay}" Margin="0,4"/>
                                <CheckBox Content="{loc:Loc Key=Apex.EnableConsole}" IsChecked="{Binding CustomLaunchOptions.Console, Mode=TwoWay}" Margin="0,4"/>

                                <!-- 姹囨€绘樉绀?-->
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSm}" Padding="8" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Key=Apex.GeneratedLaunchOptions}" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding LaunchOptionsSummary}" TextWrapping="Wrap"
                                                   FontFamily="{StaticResource FontFamilyMono}" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Button Content="{loc:Loc Key=Action.CopyToClipboard}" Command="{Binding CopyLaunchOptionsCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Padding="12,4" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?-->
                <!-- 瑙嗛璁剧疆 -->
                <!-- 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?-->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=Apex.VideoSettings}" Style="{StaticResource SectionHeader}"/>

                        <!-- 鍒嗚鲸鐜?-->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Key=Apex.Resolution}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Width="160"
                                      SelectedIndex="{Binding VideoConfig.ResolutionIndex, Mode=TwoWay}"
                                      Style="{StaticResource CustomComboBox}">
                                <ComboBoxItem Content="3840x2160"/>
                                <ComboBoxItem Content="2560x1600"/>
                                <ComboBoxItem Content="2560x1440"/>
                                <ComboBoxItem Content="2560x1080"/>
                                <ComboBoxItem Content="1920x1200"/>
                                <ComboBoxItem Content="1920x1080"/>
                                <ComboBoxItem Content="1680x1050"/>
                                <ComboBoxItem Content="1600x900"/>
                                <ComboBoxItem Content="1440x900"/>
                                <ComboBoxItem Content="1280x1024"/>
                                <ComboBoxItem Content="1280x960"/>
                                <ComboBoxItem Content="1280x800"/>
                                <ComboBoxItem Content="1280x720"/>
                            </ComboBox>
                        </Grid>

                        <!-- 鍒锋柊鐜?-->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Key=Apex.RefreshRate}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Value="{Binding VideoConfig.RefreshRate, Mode=TwoWay}"
                                    Minimum="60" Maximum="360" Style="{StaticResource CustomSlider}" Margin="8,0"/>
                            <TextBox Grid.Column="2" Text="{Binding VideoConfig.RefreshRate, Mode=TwoWay}" Style="{StaticResource NumericTextBox}"/>
                        </Grid>

