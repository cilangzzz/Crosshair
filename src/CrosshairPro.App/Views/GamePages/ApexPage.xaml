<UserControl x:Class="CrosshairPro.App.Views.GamePages.ApexPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="500" d:DesignWidth="800">

    <Grid Margin="20,12,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="APEX LEGENDS CONFIGURATION"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentBrush}"
                   Margin="0,0,0,16"/>

        <!-- 配置内容 -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource CustomScrollViewer}">
            <StackPanel>
                <!-- 启动项 -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="LAUNCH OPTIONS" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Steam 启动参数，如 +fps_max unlimited -freq 144"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Margin="0,0,0,8"/>
                        <TextBox Text="{Binding LaunchOptions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CustomTextBox}"
                                 AcceptsReturn="True"
                                 Height="60" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

                <!-- 视频设置 -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="VIDEO SETTINGS" Style="{StaticResource SectionHeader}"/>
                        
                        <!-- 全屏模式 -->
                        <CheckBox Content="Fullscreen Mode"
                                  IsChecked="{Binding Fullscreen, Mode=TwoWay}"
                                  Margin="0,8,0,12"/>

                        <!-- 最大 FPS -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Max FPS (0 = Unlimited)" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1"
                                    Value="{Binding FpsMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Minimum="0" Maximum="300"
                                    Style="{StaticResource CustomSlider}"
                                    Margin="8,0"/>
                            <TextBox Grid.Column="2"
                                     Text="{Binding FpsMax, Mode=TwoWay}"
                                     Style="{StaticResource NumericTextBox}"/>
                        </Grid>

                        <!-- 刷新率 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Refresh Rate (Hz)" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1"
                                    Value="{Binding RefreshRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Minimum="60" Maximum="360"
                                    Style="{StaticResource CustomSlider}"
                                    Margin="8,0"/>
                            <TextBox Grid.Column="2"
                                     Text="{Binding RefreshRate, Mode=TwoWay}"
                                     Style="{StaticResource NumericTextBox}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 游戏设置 -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="GAME SETTINGS" Style="{StaticResource SectionHeader}"/>
                        
                        <CheckBox Content="Show Position Info (cl_showpos)"
                                  IsChecked="{Binding ShowPos, Mode=TwoWay}"
                                  Margin="0,8"/>

                        <CheckBox Content="Show FPS (cl_showfps)"
                                  IsChecked="{Binding ShowFps, Mode=TwoWay}"
                                  Margin="0,8"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Reset"
                    Command="{Binding ResetCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0"/>
            <Button Content="Apply"
                    Command="{Binding ApplyCommand}"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</UserControl>
