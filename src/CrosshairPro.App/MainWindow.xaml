<Window x:Class="CrosshairPro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CrosshairPro.App.ViewModels"
        mc:Ignorable="d"
        Title="Crosshair Pro" Height="600" Width="900"
        Icon="Assets/app-icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="CanResize"
        MinWidth="800" MinHeight="550">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Title Bar ── -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="CROSSHAIR PRO"
                       FontSize="{DynamicResource FontSizeDisplay}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"
                       FontFamily="{DynamicResource FontFamilyMono}"/>
            <TextBlock Text=" v1.0"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Bottom" Margin="6,0,0,4"/>
        </StackPanel>

        <!-- ── Main Content ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Preview Area -->
            <Border Grid.Column="0" Style="{StaticResource PreviewCard}" Margin="0,0,12,0">
                <Grid x:Name="PreviewContainer">
                    <TextBlock Text="PREVIEW"
                               Style="{StaticResource SectionHeader}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,12,0,0"/>

                    <!-- Grid background -->
                    <Canvas x:Name="GridCanvas" Margin="20,36,20,20" ClipToBounds="True"/>

                    <!-- Crosshair render area -->
                    <Canvas x:Name="CrosshairCanvas" Margin="20,36,20,20" ClipToBounds="True"/>

                    <!-- Status indicator -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10">
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="{DynamicResource FontSizeCaption}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: Control Panel -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <ScrollViewer Style="{StaticResource CustomScrollViewer}" Padding="4">
                    <StackPanel>
                        <!-- Crosshair Style -->
                        <TextBlock Text="STYLE" Style="{StaticResource SectionHeader}"/>
                        <ComboBox x:Name="StyleComboBox"
                                  SelectedIndex="{Binding SelectedStyleIndex, Mode=TwoWay}"
                                  Style="{StaticResource CustomComboBox}"
                                  Margin="0,0,0,16"/>

                        <!-- Size -->
                        <TextBlock Text="SIZE" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    Value="{Binding Config.Size, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Minimum="1" Maximum="100"
                                    Style="{StaticResource CustomSlider}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding Config.Size, Mode=TwoWay}"
                                     Style="{StaticResource NumericTextBox}"
                                     Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Gap -->
                        <TextBlock Text="GAP" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    Value="{Binding Config.Gap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Minimum="0" Maximum="50"
                                    Style="{StaticResource CustomSlider}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding Config.Gap, Mode=TwoWay}"
                                     Style="{StaticResource NumericTextBox}"
                                     Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Thickness -->
                        <TextBlock Text="THICKNESS" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    Value="{Binding Config.Thickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Minimum="1" Maximum="10"
                                    Style="{StaticResource CustomSlider}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding Config.Thickness, Mode=TwoWay}"
                                     Style="{StaticResource NumericTextBox}"
                                     Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Opacity -->
                        <TextBlock Text="OPACITY" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    Value="{Binding Config.Opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Minimum="0" Maximum="100"
                                    Style="{StaticResource CustomSlider}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding Config.Opacity, Mode=TwoWay}"
                                     Style="{StaticResource NumericTextBox}"
                                     Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Brightness -->
                        <TextBlock Text="BRIGHTNESS" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    Value="{Binding Config.Brightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Minimum="0" Maximum="200"
                                    Style="{StaticResource CustomSlider}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding Config.Brightness, Mode=TwoWay}"
                                     Style="{StaticResource NumericTextBox}"
                                     Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Center Size -->
                        <TextBlock Text="CENTER SIZE" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    Value="{Binding Config.CenterSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Minimum="0" Maximum="30"
                                    Style="{StaticResource CustomSlider}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding Config.CenterSize, Mode=TwoWay}"
                                     Style="{StaticResource NumericTextBox}"
                                     Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Color -->
                        <TextBlock Text="COLOR" Style="{StaticResource SectionHeader}"/>
                        <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,0,0,16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Foreground="{Binding}"
                                                 Style="{StaticResource ColorSwatchRadio}"
                                                 Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Advanced Settings -->
                        <TextBlock Text="ADVANCED" Style="{StaticResource SectionHeader}"/>
                        <Expander Header="Effects" Margin="0,0,0,12">
                            <StackPanel Margin="0,8,0,0">
                                <CheckBox Content="Enable Outline"
                                          IsChecked="{Binding Config.Effects.Outline.Enabled, Mode=TwoWay}"
                                          Margin="0,4"/>
                                <Grid Margin="24,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Outline Thickness"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Config.Effects.Outline.Thickness, Mode=TwoWay}"
                                             Style="{StaticResource NumericTextBox}"/>
                                </Grid>
                                <CheckBox Content="Enable Shadow"
                                          IsChecked="{Binding Config.Effects.Shadow.Enabled, Mode=TwoWay}"
                                          Margin="0,4"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ── Bottom Toolbar ── -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="PRESET"
                           Style="{StaticResource SectionHeader}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Width="150" Style="{StaticResource CompactComboBox}">
                    <ComboBoxItem Content="Default" IsSelected="True"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Save" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                <Button Content="Import" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                <Button Content="Export" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                <Button Content="Reset" Command="{Binding ResetConfigCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                <Button Content="Toggle" Command="{Binding ToggleCrosshairCommand}" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>

        <!-- ── Status Bar ── -->
        <Border Grid.Row="3" Margin="0,12,0,0"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="{StaticResource RadiusSm}"
                Padding="12,6">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           HorizontalAlignment="Left"/>
                <TextBlock Text="Ctrl+Shift+X Toggle"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           FontFamily="{DynamicResource FontFamilyMono}"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
