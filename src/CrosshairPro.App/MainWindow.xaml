<Window x:Class="CrosshairPro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CrosshairPro.App.ViewModels"
        xmlns:views="clr-namespace:CrosshairPro.App.Views"
        xmlns:controls="clr-namespace:CrosshairPro.App.Controls"
        xmlns:loc="clr-namespace:CrosshairPro.App.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Crosshair Pro" Height="600" Width="900"
        Icon="Assets/app-icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        MinWidth="800" MinHeight="550">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- 主布局：2行 - 标题栏、内容区 -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <!-- 标题栏固定高度 -->
            <RowDefinition Height="*"/>
            <!-- 内容区自动填充 -->
        </Grid.RowDefinitions>

        <!-- ══ Row 0: 标题栏 ══ -->
        <DockPanel Grid.Row="0" Background="{DynamicResource BackgroundBrush}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="MinimizeButton" Content="&#x2013;"
                        FontSize="14" FontWeight="Bold"
                        Width="46" Height="36"
                        Style="{StaticResource TitleBarButton}"
                        Click="MinimizeButton_Click"/>
                <Button x:Name="MaximizeButton" Content="&#x25A1;"
                        FontSize="12" FontWeight="Bold"
                        Width="46" Height="36"
                        Style="{StaticResource TitleBarButton}"
                        Click="MaximizeButton_Click"/>
                <Button x:Name="CloseButton" Content="&#x00D7;"
                        FontSize="16" FontWeight="Bold"
                        Width="46" Height="36"
                        Style="{StaticResource TitleBarCloseButton}"
                        Click="CloseButton_Click"/>
            </StackPanel>
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                    <Image Source="Assets/app-icon.ico" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{loc:Loc Key=App.Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" FontFamily="{DynamicResource FontFamilyMono}" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Key=App.Version}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- ══ Row 1: 主内容区（左侧导航 + 右侧页面） ══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <!-- 导航栏固定宽度 -->
                <ColumnDefinition Width="*"/>
                <!-- 内容区填充 -->
            </Grid.ColumnDefinitions>

            <!-- 左侧导航栏 - 始终全高显示 -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4">
                        <controls:TabNavItem IconGeometry="Crosshair" IsSelected="{Binding IsCrosshairPage, Mode=OneWay}" Command="{Binding NavigateToCrosshairCommand}" ToolTip="{loc:Loc Key=Nav.Crosshair}" Margin="4"/>
                        <controls:TabNavItem IconGeometry="Gamepad" IsSelected="{Binding IsGamesPage, Mode=OneWay}" Command="{Binding NavigateToGamesCommand}" ToolTip="{loc:Loc Key=Nav.Games}" Margin="4"/>
                    </StackPanel>
                    <!-- 语言切换按钮 -->
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Button x:Name="LanguageButton" Content="🌐" FontSize="16" Width="36" Height="36"
                                Style="{StaticResource TitleBarButton}" Padding="0"
                                ToolTip="{loc:Loc Key=Nav.Language}" Click="LanguageButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧内容区 - 包含页面内容 + 底部工具栏/状态栏 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- 页面内容 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 底部区域 -->
                </Grid.RowDefinitions>

                <!-- 页面内容区 -->
                <ContentControl Grid.Row="0" Content="{Binding CurrentPage}">
                    <ContentControl.ContentTemplateSelector>
                        <controls:PageTemplateSelector>
                            <controls:PageTemplateSelector.CrosshairTemplate>
                                <DataTemplate>
                                    <views:CrosshairPage/>
                                </DataTemplate>
                            </controls:PageTemplateSelector.CrosshairTemplate>
                            <controls:PageTemplateSelector.GamesTemplate>
                                <DataTemplate>
                                    <views:GamesPage/>
                                </DataTemplate>
                            </controls:PageTemplateSelector.GamesTemplate>
                        </controls:PageTemplateSelector>
                    </ContentControl.ContentTemplateSelector>
                </ContentControl>

                <!-- 底部区域（工具栏 + 状态栏，仅准心页面显示） -->
                <StackPanel Grid.Row="1">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="Crosshair">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- 工具栏 -->
                    <Grid Margin="20,12,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Key=Preset.Label}" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Width="140" Style="{StaticResource CompactComboBox}" ItemsSource="{Binding CrosshairViewModel.Presets}" SelectedItem="{Binding CrosshairViewModel.SelectedPreset}" DisplayMemberPath="Name" Margin="0,0,4,0"/>
                            <Button Content="&#x270E;" FontSize="14" Width="32" Height="32" Style="{StaticResource SecondaryButton}" Padding="0" Click="PresetManageButton_Click" ToolTip="{loc:Loc Key=Preset.Manage}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="{loc:Loc Key=Action.Save}" Command="{Binding CrosshairViewModel.SavePresetCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                            <Button Content="{loc:Loc Key=Action.Reset}" Command="{Binding CrosshairViewModel.ResetConfigCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                            <Button Content="{loc:Loc Key=Action.Toggle}" Command="{Binding CrosshairViewModel.ToggleCrosshairCommand}" Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 状态栏 -->
                    <Border Margin="20,12,20,16" Background="{DynamicResource SurfaceBrush}" CornerRadius="{StaticResource RadiusSm}" Padding="12,6">
                        <Grid>
                            <TextBlock Text="{Binding CrosshairViewModel.StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeCaption}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{loc:Loc Key=Status.HotkeyToggle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeCaption}" FontFamily="{DynamicResource FontFamilyMono}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>