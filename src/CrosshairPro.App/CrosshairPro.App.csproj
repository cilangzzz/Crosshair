<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>CrosshairPro.App</RootNamespace>
    <AssemblyName>CrosshairPro</AssemblyName>
    <Version>1.0.0</Version>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <SupportedCultures>zh-CN;en</SupportedCultures>
  </PropertyGroup>

  <!-- Project references -->
  <ItemGroup>
    <ProjectReference Include="..\CrosshairPro.Core\CrosshairPro.Core.csproj" />
    <ProjectReference Include="..\CrosshairPro.Application\CrosshairPro.Application.csproj" />
    <ProjectReference Include="..\CrosshairPro.Services\CrosshairPro.Services.csproj" />
    <ProjectReference Include="..\CrosshairPro.Infrastructure\CrosshairPro.Infrastructure.csproj" />
  </ItemGroup>

  <!-- NuGet packages -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
  </ItemGroup>

  <!-- Resources -->
  <ItemGroup>
    <None Remove="Assets\**\*.*" />
    <Resource Include="Assets\**\*.*" />
  </ItemGroup>

</Project>
